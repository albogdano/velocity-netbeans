<!DOCTYPE fontscolors PUBLIC "-//NetBeans//DTD Editor Fonts and Colors settings 1.1//EN" "http://www.netbeans.org/dtds/EditorFontsColors-1_1.dtd">

<fontscolors>
   <fontcolor name="errors"            default="error"/>
   <fontcolor name="identifier"        default="field"/>
   <fontcolor name="keyword"           default="keyword"/>
   <fontcolor name="comment"           default="comment"/>
   <fontcolor name="unparsedcontent"   default="comment"/>
   <fontcolor name="directive"         foreColor="328fdb"/>
   <fontcolor name="macro"             foreColor="904ee6"/>
   <fontcolor name="boolean"           foreColor="CD2626"/>
   <fontcolor name="string"            default="string"/>
   <fontcolor name="separator"         foreColor="808080"/>
   <fontcolor name="operator"          foreColor="808080"/>
   <fontcolor name="number"            foreColor="8B0000"/>
</fontscolors>